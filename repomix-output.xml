        console.log("✅ WhatsApp payment confirmation sent");
      } catch (waError) {
        console.error("WhatsApp sending failed (non-critical):", waError);
      }

      // ✅ Send WhatsApp Booking Confirmation
      try {
        await invokeFunction("send-booking-confirmation-whatsapp", {
