                            ? styles.cancelled
                            : (b.payment_status === "failed" || normalizedWorkStatus === "PAYMENT FAILED")
                              ? styles.paymentFailed
                              : b.assigned_staff_email
                                ? styles.assigned
                                : styles.pending,
                      ]}
                    >
                      <Text style={styles.statusText}>
                        {normalizedWorkStatus === "COMPLETED"
