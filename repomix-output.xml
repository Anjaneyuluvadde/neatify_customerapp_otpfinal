        console.error("WhatsApp booking sending failed (non-critical):", waBookingError);
      }

      // Clear cart, session-claimed offer & profile promo fields
      await supabase.from("cart").delete().eq("user_id", userId);
      await clearClaimedOffer();
      await supabase
        .from("profile")
